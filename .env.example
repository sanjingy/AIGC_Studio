# 复制为 .env 后使用。.env 已在 .gitignore 中，绝不入库。

ENV=local
DEBUG=true
LOG_LEVEL=INFO

# --- 安全 ---
# 生产环境必须替换。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-please-change
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- 数据库 ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aigc
POSTGRES_PASSWORD=aigc_dev_password
POSTGRES_DB=aigc_studio

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- 对象存储（本地 MinIO / 生产 S3 兼容）---
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=aigc_minio
S3_SECRET_KEY=aigc_minio_password
S3_BUCKET=aigc-assets
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Provider API Key（S6 才需要，现在留空即可）---
# 绝不写进代码，绝不入库。见 ADR-014 / 05_ModelRuntimeSpec.md 第 7 节。
DEEPSEEK_API_KEY=
ARK_API_KEY=
DASHSCOPE_API_KEY=

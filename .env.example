# 复制为 .env 后使用。.env 已在 .gitignore 中，绝不入库。

ENV=local
DEBUG=true
LOG_LEVEL=INFO

# --- 安全 ---
# 生产环境必须替换。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-please-change
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600

# 凭证密文（BYOK 的 provider_credentials.key_encrypted）的对称密钥。
# base64 编码的 32 字节；留空时本地/测试从 SECRET_KEY 派生，**生产必须显式配置**。
# 生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- 数据库 ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aigc
POSTGRES_PASSWORD=aigc_dev_password
POSTGRES_DB=aigc_studio

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- 对象存储（本地 MinIO / 生产 S3 兼容）---
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=aigc_minio
S3_SECRET_KEY=aigc_minio_password
S3_BUCKET=aigc-assets
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Provider API Key（S6 才需要，现在留空即可）---
# 绝不写进代码，绝不入库。见 ADR-014 / 05_ModelRuntimeSpec.md 第 7 节。
DEEPSEEK_API_KEY=
ARK_API_KEY=
DASHSCOPE_API_KEY=

# --- 本机运行时（试点，ADR 待定，默认关闭）---
# 把某个项目的**文本生成**和**出图**交给用户自己电脑上的 Codex / Claude CLI 跑。
# 出图走 Codex 原生 image_gen，产物进同一个项目资产库。
# 详见 project_docs/modules/15_LOCAL_RUNTIME.md。
#
# 打开就必须配全，配不全直接拒绝启动。prod 一律不许开；staging 要开
# 还得再显式设 LOCAL_CLI_ALLOW_STAGING=true。
LOCAL_CLI_ENABLED=false
# 只对这一个 org 生效
LOCAL_CLI_ORG_ID=
# 显式项目白名单，逗号分隔，不许留空、不许写 *
LOCAL_CLI_PROJECT_IDS=
# **文本**走哪个本机 CLI：codex | claude
LOCAL_CLI_PROVIDER=claude
# **图片**走哪个：只有 codex（本机三个 CLI 里只有它有原生生图）
LOCAL_CLI_IMAGE_PROVIDER=codex
# 桥接令牌，至少 32 个随机字符。只授权 poll / heartbeat / result 三个端点。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 桌面那一侧从环境变量 AIGC_LOCAL_RUNNER_TOKEN 读同一个值，不要写进命令行。
LOCAL_CLI_TOKEN=
# 30 ~ 900
LOCAL_CLI_TIMEOUT_SECONDS=180
# 出图慢一个量级，单独一个上限。60 ~ 1800
LOCAL_CLI_IMAGE_TIMEOUT_SECONDS=420
LOCAL_CLI_ALLOW_STAGING=false
